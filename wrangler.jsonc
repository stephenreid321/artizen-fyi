{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artizen-fyi",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "dev": { "host": "localhost" },
  "build": {
    "command": "node scripts/prepare-release.mjs",
    "watch_dir": ["src"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "observability": { "enabled": true },
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 10000
  },
  "triggers": {
    "crons": []
  },
  "routes": [],
  "kv_namespaces": [],
  "env": {
    "cron": {
      "routes": [],
      "kv_namespaces": []
    }
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.css", "**/*.svg"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ico", "**/*.png"], "fallthrough": true }
  ]
}
